{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synthesis-station.ai/okf-schema/0.5.0/okf.schema.json",
  "title": "Synthesis Station OKF Schema v0.5.0",
  "description": "JSON Schema for validating Synthesis Station OKF markdown files",
  "type": "object",
  "required": ["okf_version", "okf_id", "okf_type", "title", "created_at", "updated_at", "confidence", "status"],
  "properties": {
    "okf_version": {
      "type": "string",
      "enum": ["0.5.0"]
    },
    "okf_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "okf_type": {
      "type": "string",
      "enum": [
        "paper_synthesis",
        "video_synthesis",
        "concept",
        "person",
        "repo_synthesis",
        "dataset",
        "qa_session",
        "learning_path",
        "eval_result",
        "source_claim"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "deprecated", "superseded"]
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related": {
      "type": "array",
      "items": { "type": "string" }
    },
    "license": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "source"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "source": { "type": "string", "format": "uri" },
          "source_ref": { "type": "string" },
          "source_section": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "okf_type": { "const": "paper_synthesis" } }
      },
      "then": {
        "required": ["source", "source_id", "source_url", "published_date", "citations"]
      }
    },
    {
      "if": {
        "properties": { "okf_type": { "const": "qa_session" } }
      },
      "then": {
        "required": ["user_query", "answer_model", "citations"]
      }
    },
    {
      "if": {
        "properties": { "okf_type": { "const": "learning_path" } }
      },
      "then": {
        "required": ["target_audience", "estimated_hours", "steps"]
      }
    }
  ]
}
